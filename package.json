{
  "name": "sar-website-template",
  "version": "1.0.0",
  "private": true,
  "description": "Reference website -> Save All Resources capture -> reusable website template",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:extension": "node extension/build.mjs",
    "build:editor": "node app/editor/build.mjs",
    "start": "node app/server.mjs",
    "editor": "node app/editor/cli.mjs",
    "capture": "node app/cli.mjs",
    "fixture": "node test/fixtures/fixture-server.mjs",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=900000 \"test/e2e/*.test.mjs\"",
    "test:all": "npm run build:extension && npm run build:editor && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "puppeteer": "^25.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@zip.js/zip.js": "^2.22.0",
    "esbuild": "^0.28.2",
    "prettier": "2.8.8",
    "tailwindcss": "^4.3.3"
  }
}
